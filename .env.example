NODE_ENV=development
PORT=3002

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=school_management
DB_SYNCHRONIZE=false
DB_LOGGING=false
# Hub always connects to 'colegios' schema — no DB_SCHEMA variable needed

JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=8h

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=skool-next-stage

SWAGGER_ENABLED=true
WHITELIST_TRUSTED_URLS=http://localhost:3003

# Bootstrap password for hub users created from the console, and the value a
# password reset drops an account back to. Never returned by the API; the user
# is forced to change it on first sign-in.
HUB_DEFAULT_PASSWORD=123456

# ── School AI admin integration ───────────────────────────────────────────────
AI_BACKEND_URL=http://localhost:8001
# Must match INTERNAL_API_KEY in school-ai's .env
AI_INTERNAL_KEY=strong-random-key-for-nestjs-to-ai-calls

